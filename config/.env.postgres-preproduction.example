# LegalAIZ.it M31.5 v5.0.4 — preproducción PostgreSQL.
LEGAL_PROFILE=pilot
LEGAL_APP_ENV=preproduction
LEGAL_PUBLIC_BASE_URL=https://preproduccion.legalaiz.it
LEGAL_DATABASE_BACKEND=postgresql
PGHOST=database
PGPORT=5432
PGDATABASE=legalaiz
PGUSER=legalaiz
LEGAL_POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
LEGAL_POSTGRES_SCHEMA=public
LEGAL_POSTGRES_CONNECT_TIMEOUT=30
LEGAL_POSTGRES_APPLICATION_NAME=legalaizit-m31.5
LEGAL_SECURE_COOKIES=true
LEGAL_TRUST_PROXY=true
LEGAL_TRUSTED_PROXY_IPS=127.0.0.1,::1
LEGAL_REQUIRE_ORIGIN_CHECK=true
LEGAL_OBJECT_STORAGE=local-encrypted
LEGAL_OBJECT_ENCRYPTION=true
LEGAL_VOLUME_ENCRYPTION_CONFIRMED=true
LEGAL_MASTER_KEY_FILE=/run/secrets/legalaiz_master_key
LEGAL_CONFLICT_HASH_KEY_FILE=/run/secrets/legalaiz_conflict_hash_key
LEGAL_REQUIRE_MFA_ROLES=admin,specialist
LEGAL_ALLOW_DEMO_ACCOUNTS=false
LEGAL_MALWARE_SCANNER=clamav
LEGAL_CLAMAV_HOST=clamav
LEGAL_CLAMAV_PORT=3310
LEGAL_POSTGRES_EXTERNAL_CERTIFIED=false
# En proveedores administrados use verify-full o el modo exigido por el proveedor.
PGSSLMODE=prefer
