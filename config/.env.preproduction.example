# LegalAIZ.it M31.3 v5.0.2 — preproducción administrada. No contiene secretos reales.
LEGAL_PROFILE=pilot
LEGAL_APP_ENV=preproduction
LEGAL_RUNTIME_DIR=/var/lib/legalaizit/runtime
LEGAL_PUBLIC_BASE_URL=https://preproduccion.legalaiz.it
LEGAL_SECURE_COOKIES=true
LEGAL_TRUST_PROXY=true
LEGAL_TRUSTED_PROXY_IPS=127.0.0.1,::1
LEGAL_REQUIRE_ORIGIN_CHECK=true
LEGAL_SESSION_IDLE_MINUTES_CLIENT=90
LEGAL_SESSION_IDLE_MINUTES_PRIVILEGED=20

# Persistencia. SQLite permanece admitido únicamente para preproducción limitada.
LEGAL_DATABASE_BACKEND=sqlite
LEGAL_OBJECT_STORAGE=local-encrypted
LEGAL_OBJECT_ENCRYPTION=true
LEGAL_VOLUME_ENCRYPTION_CONFIRMED=true

# Secretos montados por el orquestador; nunca dentro del ZIP o la imagen.
LEGAL_MASTER_KEY_FILE=/run/secrets/legalaiz_master_key
LEGAL_CONFLICT_HASH_KEY_FILE=/run/secrets/legalaiz_conflict_hash_key
LEGAL_REQUIRE_MFA_ROLES=admin,specialist
LEGAL_ALLOW_DEMO_ACCOUNTS=false

# Archivos y continuidad
LEGAL_MALWARE_SCANNER=clamav
LEGAL_CLAMAV_HOST=clamav
LEGAL_CLAMAV_PORT=3310
LEGAL_BACKUP_RETENTION=30
LEGAL_MAX_UPLOAD_MB=10
LEGAL_LOG_MAX_BYTES=5242880
LEGAL_LOG_RETENTION=5

# Bootstrap temporal. Inyectar desde el gestor de secretos y retirar tras crear el administrador.
LEGAL_BOOTSTRAP_ADMIN_EMAIL=admin@legalaiz.it
LEGAL_BOOTSTRAP_ADMIN_PASSWORD=
LEGAL_BOOTSTRAP_ADMIN_NAME=Administrador LegalAIZ.it
LEGAL_BOOTSTRAP_ADMIN_SPECIALTY=Gobernanza jurídica y producto
