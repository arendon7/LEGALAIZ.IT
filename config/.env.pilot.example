# Perfil: local, pilot o production
LEGAL_PROFILE=pilot
LEGAL_APP_ENV=pilot
LEGAL_PUBLIC_BASE_URL=https://localhost:8443
LEGAL_SECURE_COOKIES=true
LEGAL_TRUST_PROXY=true
LEGAL_TRUSTED_PROXY_IPS=127.0.0.1,::1
LEGAL_REQUIRE_ORIGIN_CHECK=true
LEGAL_SESSION_IDLE_MINUTES_CLIENT=120
LEGAL_SESSION_IDLE_MINUTES_PRIVILEGED=30

# Datos
LEGAL_DATABASE_BACKEND=sqlite
LEGAL_OBJECT_STORAGE=local-encrypted
LEGAL_OBJECT_ENCRYPTION=true
LEGAL_VOLUME_ENCRYPTION_CONFIRMED=true

# Seguridad
# Preferir un secreto montado por el orquestador. El archivo debe contener Base64 URL-safe de 32 bytes.
LEGAL_MASTER_KEY_FILE=/run/secrets/legalaiz_master_key
LEGAL_REQUIRE_MFA_ROLES=admin,specialist
LEGAL_MALWARE_SCANNER=clamav
LEGAL_CLAMAV_COMMAND=clamscan
# Alternativa en contenedor: LEGAL_CLAMAV_HOST=clamav y LEGAL_CLAMAV_PORT=3310
LEGAL_BACKUP_RETENTION=30
LEGAL_MAX_UPLOAD_MB=10

# Administrador inicial. Retirar la contraseña después del bootstrap y rotarla.
LEGAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LEGAL_BOOTSTRAP_ADMIN_PASSWORD=
LEGAL_BOOTSTRAP_ADMIN_NAME=Administrador LegalAIZ.it
LEGAL_BOOTSTRAP_ADMIN_SPECIALTY=Gobernanza jurídica y producto
LEGAL_ALLOW_DEMO_ACCOUNTS=false

# M24.9: obligatorio fuera de local para huellas de conflictos de interés
LEGAL_CONFLICT_HASH_KEY=
