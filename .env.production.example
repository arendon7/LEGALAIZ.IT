# LegalAIZ.it V1-RC1 — plantilla de producción NO ejecutable por defecto.
# No contiene secretos reales. Los valores SET_IN_* deben inyectarse desde el
# proveedor/gestor de secretos. Mantener launch/payments/communications en false
# hasta completar las compuertas técnicas, jurídicas, QA y privacidad.

LEGAL_PROFILE=production
LEGAL_APP_ENV=production
LEGAL_RUNTIME_DIR=/var/lib/legalaiz

# Red y sesión
LEGAL_PUBLIC_BASE_URL=https://SET_IN_DEPLOYMENT_PROVIDER
LEGAL_SECURE_COOKIES=true
LEGAL_REQUIRE_ORIGIN_CHECK=true
LEGAL_TRUST_PROXY=true
LEGAL_TRUSTED_PROXY_IPS=SET_IN_DEPLOYMENT_PROVIDER

# Identidad
LEGAL_ALLOW_DEMO_ACCOUNTS=false
LEGAL_PUBLIC_DEMO_MODE=false
LEGAL_REQUIRE_MFA_ROLES=admin,specialist
# Bootstrap es opcional. Si se usa, ambos valores deben provenir del gestor de secretos.
# LEGAL_BOOTSTRAP_ADMIN_EMAIL=admin@empresa.example
# LEGAL_BOOTSTRAP_ADMIN_PASSWORD=SET_IN_SECRET_MANAGER

# Persistencia
LEGAL_DATABASE_BACKEND=postgresql
DATABASE_URL=SET_IN_SECRET_MANAGER
LEGAL_POSTGRES_EXTERNAL_CERTIFIED=false
LEGAL_OBJECT_STORAGE=local-encrypted
LEGAL_OBJECT_ENCRYPTION=true
LEGAL_VOLUME_ENCRYPTION_CONFIRMED=false
LEGAL_BACKUP_RETENTION=10

# Cifrado: configure exactamente una fuente administrada.
LEGAL_MASTER_KEY_FILE=/run/secrets/legalaiz_master_key
# LEGAL_MASTER_KEY=SET_IN_SECRET_MANAGER
# LEGAL_MASTER_KEY_SEED=SET_IN_SECRET_MANAGER

# Archivos y antimalware
LEGAL_MALWARE_SCANNER=clamav
LEGAL_CLAMAV_HOST=SET_IN_PRIVATE_NETWORK
LEGAL_CLAMAV_PORT=3310
LEGAL_MAX_UPLOAD_MB=10

# Límites comerciales: RC1 debe permanecer bloqueado por defecto.
LEGAL_PRODUCTION_LAUNCH_AUTHORIZED=false
LEGAL_REAL_PAYMENTS_AUTHORIZED=false
LEGAL_PAYMENT_PROVIDER=sandbox
LEGAL_EXTERNAL_COMMUNICATIONS_AUTHORIZED=false
LEGAL_COMMUNICATION_PROVIDER=disabled
LEGAL_LEGAL_PORTFOLIO_FINAL_APPROVED=false
LEGAL_QA_PORTFOLIO_FINAL_APPROVED=false
LEGAL_PRIVACY_FINAL_APPROVED=false
