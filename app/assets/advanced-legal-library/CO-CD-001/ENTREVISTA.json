{
  "version": "2.32",
  "intro": "Responde únicamente con información confirmada. El sistema distingue consulta, reclamo, responsables, comunicación previa, permanencia, suplantación, términos y escalamiento.",
  "sections": [
    "Titular y legitimación",
    "Clasificación jurídica",
    "Intervinientes",
    "Obligación y reporte",
    "Comunicación previa",
    "Gestiones previas",
    "Riesgo y escalamiento",
    "Términos y control"
  ],
  "questions": [
    {
      "id": "data_subject_name",
      "label": "Nombre completo del titular de la información",
      "type": "text",
      "required": true,
      "section": "Titular y legitimación",
      "min_length": 3
    },
    {
      "id": "data_subject_id",
      "label": "Identificación del titular",
      "type": "text",
      "required": true,
      "section": "Titular y legitimación",
      "min_length": 4
    },
    {
      "id": "acting_capacity",
      "label": "Calidad en la que actúa quien presenta",
      "type": "select",
      "options": [
        "Titular",
        "Apoderado o autorizado",
        "Representante legal",
        "Causahabiente",
        "Otro tercero con legitimación acreditada"
      ],
      "required": true,
      "section": "Titular y legitimación"
    },
    {
      "id": "representative_name",
      "label": "Nombre del representante o autorizado",
      "type": "text",
      "required": true,
      "section": "Titular y legitimación",
      "min_length": 3,
      "show_if": {
        "field": "acting_capacity",
        "equals": "Apoderado o autorizado"
      }
    },
    {
      "id": "representation_support",
      "label": "Soporte de legitimación disponible",
      "type": "select",
      "options": [
        "Completo",
        "Parcial",
        "No",
        "No aplica"
      ],
      "required": true,
      "section": "Titular y legitimación"
    },
    {
      "id": "email",
