      "required": true,
      "section": "Actuación oficial",
      "options": [
        "Sin actuación identificada",
        "Apertura o formulación de cargos",
        "Investigación en curso",
        "Decisión firme favorable individual",
        "Decisión firme desfavorable individual",
        "Estado no confirmado"
      ]
    },
    {
      "id": "official_act_source",
