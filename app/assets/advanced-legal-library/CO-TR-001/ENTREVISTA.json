      "options": [
        "Sí",
        "No",
        "No sé",
        "No aplica a la conducta"
      ]
    },
    {
      "id": "calibration_date",
      "label": "Fecha del certificado o verificación técnica",
      "type": "date",
      "required": false,
      "section": "Control técnico"
