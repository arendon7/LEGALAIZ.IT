      "options": [
        "Sí",
        "No",
        "No sé",
        "Excepción legal identificada"
      ]
    },
    {
      "id": "authorization_number",
      "label": "Número de autorización",
      "type": "text",
      "required": false,
      "section": "Control técnico"
    },
    {
      "id": "authorization_issue_date",
