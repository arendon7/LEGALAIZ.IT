    {
      "id": "case_count",
      "label": "Número de comparendos relacionados",
      "type": "number",
      "required": true,
      "section": "Complejidad",
      "min": 1,
      "max": 1000
    },
    {
      "id": "evidence_available",
      "label": "Nivel de soportes disponibles",
      "type": "select",
      "required": true,
      "section": "Evidencia",
      "options": [
        "Expediente técnico completo",
        "Comparendo y consultas oficiales",
        "Solo consulta o captura",
        "Sin soportes verificables"
      ]
    },
    {
      "id": "deadline_urgent",
      "label": "¿Existe término, audiencia o actuación en menos de 10 días?",
      "type": "select",
      "required": true,
