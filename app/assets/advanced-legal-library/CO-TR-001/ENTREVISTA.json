{
  "version": "2.26",
  "intro": "Este flujo cruza datos del comparendo con una muestra curada y exige verificación individual en fuentes oficiales. Una coincidencia no equivale a nulidad, revocatoria o devolución.",
  "sections": [
    "Interesado",
    "Comparendo",
    "Dispositivo",
    "Actuación oficial",
    "Control técnico",
    "Etapa",
    "Complejidad",
    "Evidencia",
    "Riesgo",
    "Consentimientos"
  ],
  "questions": [
    {
      "id": "requester_name",
      "label": "Nombre completo del interesado",
      "type": "text",
      "required": true,
      "section": "Interesado",
      "min_length": 3
    },
    {
      "id": "requester_id",
      "label": "Número de identificación",
      "type": "text",
      "required": true,
      "section": "Interesado",
      "min_length": 5
    },
    {
      "id": "email",
      "label": "Correo para el expediente y las alertas",
      "type": "text",
      "required": true,
      "section": "Interesado",
      "format": "email"
    },
    {
      "id": "phone",
      "label": "Teléfono de contacto",
      "type": "text",
      "required": false,
      "section": "Interesado"
    },
    {
      "id": "address",
      "label": "Dirección para notificaciones",
      "type": "text",
      "required": false,
      "section": "Interesado"
    },
    {
      "id": "acting_capacity",
      "label": "Calidad en la que actúa",
      "type": "select",
      "required": true,
      "section": "Interesado",
      "options": [
        "Propietario",
        "Conductor",
        "Apoderado",
        "Otro interesado legítimo"
      ]
    },
    {
      "id": "plate",
      "label": "Placa del vehículo",
      "type": "text",
      "required": true,
      "section": "Comparendo",
      "min_length": 5,
      "max_length": 8
