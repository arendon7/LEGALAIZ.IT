    {
      "id": "notice_status",
      "label": "¿Cómo conoció el comparendo o la actuación?",
      "type": "select",
      "required": true,
      "section": "Etapa",
      "options": [
        "Notificación recibida",
        "Consulta SIMIT/RUNT",
        "Cobro persuasivo",
        "Cobro coactivo",
        "Embargo",
        "Otro"
      ]
    },
    {
      "id": "first_knowledge_date",
      "label": "Fecha de conocimiento efectivo",
      "type": "date",
      "required": false,
      "section": "Etapa"
    },
    {
      "id": "enforcement",
      "label": "Estado procesal actual conocido",
      "type": "select",
      "required": true,
      "section": "Etapa",
      "options": [
        "Sin proceso conocido",
        "Comparendo sin decisión conocida",
        "Resolución sancionatoria",
        "Cobro coactivo",
        "Embargo",
        "Proceso judicial"
      ]
    },
    {
      "id": "paid",
      "label": "¿La obligación fue pagada total o parcialmente?",
      "type": "select",
      "required": true,
      "section": "Etapa",
      "options": [
        "No",
        "Sí",
        "No sé"
      ]
