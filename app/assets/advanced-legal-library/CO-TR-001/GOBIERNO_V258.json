{
  "version": "2.58",
  "workflow": ["draft", "blocked_professional_review", "pending_legal_review", "pending_qa_review", "approved", "released"],
  "roles": {
    "user": ["create_draft", "request_revision"],
    "specialist_legal": ["legal_approve", "legal_reject"],
    "qa": ["qa_approve", "qa_reject"],
    "admin": ["inspect", "legal_approve", "qa_approve", "release"]
  },
  "controls": {
    "immutable_revisions": true,
    "hash_algorithm": "SHA-256",
    "audit_chain": true,
    "dual_approval": true,
    "same_actor_dual_approval": false,
    "qa_requires_current_legal_approval": true,
    "release_with_red_risk": false,
    "release_with_missing_variables": false,
    "release_without_v257_base": false,
    "source_revalidation_before_external_use": true,
    "precheck_identity_minimization": true,
    "registration_requires_separate_data_consent": true
  }
}
