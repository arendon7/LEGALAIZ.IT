  "conditional_rules": [
    {
      "id": "LAB-M23-001",
      "when": "employment_need_is_permanent_or_has_no_objective_end",
      "then": "use_indefinite_term",
      "risk": "green"
    },
    {
      "id": "LAB-M23-002",
      "when": "fixed_term_selected",
      "then": "validate_written_form_and_four_year_maximum_and_renewal_history",
      "risk": "yellow"
    },
    {
      "id": "LAB-M23-003",
      "when": "work_or_task_selected",
      "then": "require_precise_detailed_verifiable_work_and_end_event",
      "risk": "yellow"
    },
    {
      "id": "LAB-M23-004",
      "when": "weekly_hours_gt_42_without_special_regime",
      "then": "block_generation",
      "risk": "red"
    },
    {
      "id": "LAB-M23-005",
      "when": "work_after_19_00_or_before_06_00",
      "then": "activate_night_surcharge",
      "risk": "yellow"
    },
    {
      "id": "LAB-M23-006",
      "when": "rest_day_work_date_between_2026_07_01_and_2027_06_30",
      "then": "apply_90_percent_surcharge_unless_employer_adopts_100_percent",
      "risk": "yellow"
    },
    {
      "id": "LAB-M23-007",
      "when": "disciplinary_process_and_employer_has_10_or_more_workers",
      "then": "apply_full_article_115_procedure_and_minimum_five_day_defence_term",
      "risk": "red"
    },
    {
      "id": "LAB-M23-008",
      "when": "micro_or_small_employer_with_fewer_than_10_workers",
      "then": "at_minimum_hear_worker_before_decision_and_respect_defence_and_due_process",
      "risk": "yellow"
    },
    {
      "id": "LAB-M23-009",
      "when": "pregnancy_disability_health_union_protection_or_other_enhanced_stability",
      "then": "mandatory_human_legal_review_before_high_impact_decision",
      "risk": "red"
    },
    {
      "id": "LAB-M23-010",
      "when": "non_salary_label_on_regular_service_payment",
      "then": "reclassify_or_mandatory_review",
      "risk": "red"
    },
    {
      "id": "LAB-M23-011",
      "when": "public_ai_tool_or_unapproved_cloud_will_receive_confidential_or_personal_data",
      "then": "prohibit_and_warn",
      "risk": "red"
    },
    {
      "id": "LAB-M23-012",
      "when": "automatic_salary_deduction_for_loss_damage_or_equipment",
      "then": "remove_and_require_evidence_authorisation_or_legal_basis_and_due_process",
      "risk": "red"
    },
    {
      "id": "LAB-M23-013",
      "when": "general_post_contract_non_compete",
      "then": "remove_or_escalate",
      "risk": "red"
    },
    {
      "id": "LAB-M23-014",
      "when": "employee_resignation_without_30_day_notice",
      "then": "do_not_apply_contractual_penalty",
      "risk": "green"
    }
  ],
