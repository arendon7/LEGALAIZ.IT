{
  "version": "M23.2-2026-07-31",
  "product_code": "CO-LA-002",
  "document": "employment_indefinite",
  "strategy": "additive_maturation",
  "preserve": [
    "existing questions, variables and rules that remain legally and functionally useful",
    "existing annexes and case-specific modules",
    "RBAC, immutable reviews, version comparison, dual approval and DOCX/PDF generation"
  ],
